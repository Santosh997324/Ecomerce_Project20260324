@model AdminPanel.Models.MasterModel
@{
    ViewData["Title"] = "ProductColor";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 1;
}

<div class="page-content">
    <div class="container-fluid">
        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Welcome to Product Color </h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Product Color</a></li>
                            <li class="breadcrumb-item active">Product Color</li>
                        </ol>
                    </div>

                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-lg-12">
                @if(Model.ProductColor_Obj == null)
                {
                     <div class="card">
                    <div class="card-header align-items-center d-flex">
                        <h4 class="card-title mb-0 flex-grow-1">Product Color Form</h4>
                    </div><!-- end card header -->
                    <form asp-action="AddProductColor" asp-controller="Product"
                          method="post" enctype="multipart/form-data">

                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-6 mb-3">
                                    <label>Product Color<span class="text-danger">*</span></label>
                                    <input type="text" asp-for="ProductColor_Obj.Name" class="form-control" placeholder="Product Color" />
                                </div>
                                <div class="col-lg-6">
                                    <button type="submit"
                                            class="btn btn-primary">
                                        Submit
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                    </div>

                }
                else
                {
                    <div class="card">
                    <div class="card-header align-items-center d-flex">
                        <h4 class="card-title mb-0 flex-grow-1">Product Form</h4>
                    </div><!-- end card header -->
                    <form asp-action="UpdateProductColor" asp-controller="Product"
                          method="post" enctype="multipart/form-data">

                        <div class="card-body">
                            <div class="row">
                                                             
                                <div class="col-lg-6 mb-3">
                                    <label>Product Color Name <span class="text-danger">*</span></label>
                                    <input type="text" asp-for="ProductColor_Obj.Name" class="form-control" placeholder="Color Name" />
                                </div>

                                <input type="hidden" asp-for="ProductColor_Obj.Id"/>

                                <div class="col-lg-6">
                                    <button type="submit"
                                            class="btn btn-primary">
                                        Update
                                    </button>
                                </div>

                            </div>
                        </div>

                    </form>
                </div>
                }
            </div> <!-- end col -->
        </div>

        @if (Model.ProductColor_List != null && Model.ProductColor_List.Count > 0)
        {
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Material List</h5>
                        </div>
                        <div class="card-body">
                            <table id="model-datatables" class="table table-bordered nowrap table-striped align-middle" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Sr No.</th>
                                        <th>Name</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var items in Model.ProductColor_List)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td>@items.Name</td>            
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <!-- EDIT BUTTON -->
                                                    <a asp-controller="Product"
                                                       asp-action="ProductColor"
                                                       asp-route-Product_Color_Id="@items.Id"
                                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        <i class="ri-pencil-fill me-1"></i>
                                                        Edit
                                                    </a>
                                                    <!-- DELETE BUTTON -->
                                                    <a asp-controller="Product" asp-action="DeleteProductColor" asp-route-Product_Color_Id="@items.Id"
                                                       class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        <i class="ri-delete-bin-fill me-1"></i>
                                                        Delete
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
                }
    </div>
</div>

